API_IMAGE=youracr.azurecr.io/inventory-tracker-api:stage
API_PORT=8080
CLIENT_ORIGIN=https://your-stage-frontend-url
JWT_KEY=replace-with-a-long-random-secret
POSTGRES_CONNECTION_STRING=Host=your-stage-postgres.postgres.database.azure.com;Port=5432;Database=inventorytrackerdb;Username=appuser;Password=replace-me;Ssl Mode=Require;Trust Server Certificate=true
AZURE_BLOB_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=yourstorageaccount;AccountKey=replace-me;EndpointSuffix=core.windows.net
AZURE_BLOB_CONTAINER=product-images-stage
