{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Information",
        "System": "Warning"
      }
    },
    "WriteTo": [ "Console" ]
  },
  "AllowedHosts": "*",
  "Cors": {
    "AllowedOrigins": [ "http://localhost:3000" ]
  },
  "ConnectionStrings": {
    "Default": "Host=localhost;Port=5432;Database=inventorytrackerdb;Username=postgres;Password=postgres"
  },
  "ProductImageStorage": {
    "Provider": "Local",
    "ContainerName": "product-images"
  },
  "Jwt": {
    "Key": "superdupersecretkeythatsreallyreallylong"
  }
}
